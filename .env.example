# Ollama does not validate this key — keep as-is
OLLAMA_API_KEY=ollama

# Required by Chainlit when any auth callback is registered
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# Chainlit server binding
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Optional — enables the release/advisory check tool (agent/tools/release_check.py).
# Free tier at https://tavily.com. Leave blank to disable the tool gracefully.
TAVILY_API_KEY=
