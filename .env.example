# Ollama does not validate this key — keep as-is
OLLAMA_API_KEY=ollama

# Required by Chainlit when any auth callback is registered
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# Chainlit server binding
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Optional — enables the release/advisory check tool (agent/tools/release_check.py).
# Free tier at https://tavily.com. Leave blank to disable the tool gracefully.
TAVILY_API_KEY=

# Optional — Hedera Consensus Service audit-trail tools (agent/tools/hedera.py).
# Only used when config/hedera.yaml has `enabled: true`. Testnet account from
# https://portal.hedera.com/ — use the DER-encoded private key (302e… / 3030…),
# not the 0x hex form. See HEDERA.md.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=

# Optional — OpenAI API models (provider: openai in config/models.yaml). Their picker
# entries stay hidden until this is set; providers.openai.enabled switches them off
# entirely. Everything the agent sees is sent to OpenAI — see the providers: comment.
OPENAI_API_KEY=

# Guardian Platform mode (config/guardian.yaml enabled: true) — the local Viper proxy
# that signs every chat-model call. Run: viper proxy --port 8090 --require-agent-header \
#   --gateway-endpoint http://<gateway>:10000/v1/openai_api
VIPER_PROXY_URL=http://127.0.0.1:8090

# Lineage registration (config/lineage.yaml register.enabled: true) — a Guardian API key with
# Create Declarations + View Project Data on the project. The EQTY SDK reads it from here.
EQTY_API_KEY=
# Upload lineage in batches (/statements/v1/batch): ~4 s per turn instead of ~24 s.
EQTY_BATCH_REGISTER=true
