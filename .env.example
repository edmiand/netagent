# Ollama does not validate this key — keep as-is
OLLAMA_API_KEY=ollama

# Required by Chainlit when any auth callback is registered
# Generate with: openssl rand -hex 32
CHAINLIT_AUTH_SECRET=

# Chainlit server binding
CHAINLIT_HOST=0.0.0.0
CHAINLIT_PORT=8000

# Optional — enables the release/advisory check tool (agent/tools/release_check.py).
# Free tier at https://tavily.com. Leave blank to disable the tool gracefully.
TAVILY_API_KEY=

# Optional — Hedera Consensus Service audit-trail tools (agent/tools/hedera.py).
# Only used when config/hedera.yaml has `enabled: true`. Testnet account from
# https://portal.hedera.com/ — use the DER-encoded private key (302e… / 3030…),
# not the 0x hex form. See HEDERA.md.
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
